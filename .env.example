# =============================================================================
# CONFIGURACIÓN DEL SITIO — PINEDA Y ASOCIADOS
# =============================================================================
# Copie este archivo a `.env.local` y complete los valores reales.
# Las variables que empiezan con NEXT_PUBLIC_ son visibles en el cliente.
# Las que NO tienen ese prefijo solo están disponibles en el servidor.
# =============================================================================

# -----------------------------------------------------------------------------
# Identidad y dominio
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.pinedayasociadoshn.com
NEXT_PUBLIC_SITE_NAME="Pineda y Asociados"
NEXT_PUBLIC_SITE_SHORT="Pineda y Asociados"
NEXT_PUBLIC_SITE_TAGLINE="Abogados penalistas en Nacaome, Valle — Defensa penal seria y confidencial"
NEXT_PUBLIC_SITE_DESCRIPTION="Bufete penalista en Nacaome, Valle, Honduras. Defensa técnica en Código Penal, asistencia a detenidos, asesoría preventiva y atención a víctimas."
NEXT_PUBLIC_SITE_KEYWORDS="abogado penalista Nacaome, abogados Nacaome Honduras, defensa penal Honduras, abogado Código Penal, abogado penal Valle, asistencia a detenidos, proceso penal Honduras, abogado cerca de Hondutel, bufete penalista Valle"

# -----------------------------------------------------------------------------
# Contacto
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE="+50495363724"
NEXT_PUBLIC_CONTACT_WHATSAPP="50495363724"
NEXT_PUBLIC_CONTACT_EMAIL="contacto@pinedayasociadoshn.com"

# -----------------------------------------------------------------------------
# Geolocalización del bufete
# Coordenadas exactas (Plus Code: GGJ7+239, Nacaome, Valle, Honduras)
# Sobrescribibles vía env; si se dejan vacías, se usan los valores por defecto.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GEO_LAT=13.5300375
NEXT_PUBLIC_GEO_LNG=-87.487265625

# -----------------------------------------------------------------------------
# Redes sociales (opcional, completar cuando existan)
# Dejar vacío si el perfil no existe. NO inventar URLs.
# Alimentan los schemas Organization/LegalService (sameAs) y el footer.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=

# -----------------------------------------------------------------------------
# Control de indexación y privacidad
# -----------------------------------------------------------------------------
# "true"  → noindex global, robots bloqueado, sitemap vacío (solo desarrollo/staging)
# "false" → indexación permitida (producción)
NEXT_PUBLIC_NOINDEX=false

# -----------------------------------------------------------------------------
# Verificación de buscadores (Google Search Console, Bing, etc.)
# -----------------------------------------------------------------------------
# Código de verificación de Google Search Console (meta tag).
# Obtenlo en GSC → Ajustes → Verificar propiedad → Metaetiqueta.
# Copia solo el valor del atributo content (sin las comillas).
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Código de verificación de Bing Webmaster Tools (msvalidate.01).
# Obtenlo en Bing WMT → Configurar → Verificación → Metaetiqueta (valor del content).
# Si se deja vacío, se usa el valor histórico hardcodeado en app/layout.tsx
# (fallback) para no romper la verificación existente.
NEXT_PUBLIC_BING_VERIFICATION=

# -----------------------------------------------------------------------------
# Google APIs (GA4 Data API + Search Console API) — servidor (NO NEXT_PUBLIC)
# -----------------------------------------------------------------------------
# Cuenta de servicio de Google Cloud con acceso a GA4 y Search Console.
# 1. Crear cuenta de servicio en Google Cloud Console → IAM → Cuentas de servicio.
# 2. Generar clave JSON y copiar client_email y private_key.
# 3. Añadir la cuenta de servicio como:
#    - "Visualizador" en GA4 → Administración → Usuarios
#    - "Propietario completo" en Search Console → Ajustes → Usuarios
# 4. Activar APIs en Google Cloud Console:
#    - Google Analytics Data API (analyticsdata.googleapis.com)
#    - Google Search Console API (searchconsole.googleapis.com)
# 5. La private_key debe incluir los saltos de línea como \\n.
#    Ejemplo: "-----BEGIN PRIVATE KEY-----\\nMIIEv...\\n-----END PRIVATE KEY-----\\n"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Property ID de Google Analytics 4 (numérico, ej. 123456789).
# Obtenlo en GA4 → Administración → Configuración de la propiedad → ID de propiedad.
GOOGLE_ANALYTICS_PROPERTY_ID=
# URL de la propiedad en Google Search Console.
# Formatos aceptados:
#   sc-domain:pinedayasociadoshn.com
#   https://www.pinedayasociadoshn.com/
# Obtenlo en Search Console → Ajustes → Propiedad → URL de la propiedad.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Ruta al archivo JSON de credenciales de la cuenta de servicio (alternativa).
# Usar SOLO si no se usan las variables individuales de arriba.
# En Vercel, prefiere las variables individuales.
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Google Analytics 4 — frontend (NEXT_PUBLIC)
# -----------------------------------------------------------------------------
# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Obtenlo en GA4 → Administración → Flujos de datos → ID de medición.
NEXT_PUBLIC_GA_ID=
# Google Tag Manager (opcional). Si se configura (formato GTM-XXXXXX), GTM
# gestiona GA4 y el resto de etiquetas; se ignora NEXT_PUBLIC_GA_ID directo.
# Solo activar si se gestiona la analítica vía GTM en lugar de gtag.js.
NEXT_PUBLIC_GTM_ID=
# Facebook Pixel (opcional, formato numérico). Solo activar si existe ID real
# Y se implementa banner de consentimiento de cookies. El sitio carga Consent
# Mode v2 por defecto (cookies denegadas hasta consentimiento explícito).
NEXT_PUBLIC_FB_PIXEL_ID=
# API secret de Measurement Protocol de Google Analytics 4.
# Permite enviar eventos server-side (conversiones, leads, consultas).
# Obtenlo en GA4 → Administración → Flujos de datos → tu flujo → Measurement Protocol API secrets.
# Guardar en .env.local, NO commiteado.
GA_MEASUREMENT_PROTOCOL_SECRET=
# ID de proyecto de Microsoft Clarity (formato alfanumérico).
# Obtenlo en Clarity → Configuración → Configuración → ID del proyecto.
NEXT_PUBLIC_CLARITY_ID=
# Diagnóstico local de analítica (opcional, SOLO development).
# Si vale "true" y NODE_ENV!=="production", el navegador emite logs
#   [analytics:debug] enabled/skipped/page_view
# en la consola para verificar que las rutas públicas disparan GA4 y las
# privadas (/intranet, /cp, /calculadora, /api, ...) no. En producción
# NUNCA se emiten estos logs, independientemente del valor de la variable.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# -----------------------------------------------------------------------------
# Base de datos (Neon) — requerido para intranet y calculadora
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Autenticación y seguridad
# -----------------------------------------------------------------------------
JWT_SECRET=
INTRANET_RATE_LIMIT_PER_MIN="10"

# -----------------------------------------------------------------------------
# Email transaccional (formularios de contacto) — configurar al elegir proveedor
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="no-reply@pinedayasociadoshn.com"
CONTACT_NOTIFICATION_EMAIL="alfonsroiget@gmail.com"
# Secreto de firma del webhook de Resend (formato whsec_...).
# Se obtiene en Resend → Webhooks → tu webhook → "Signing secret".
# Sin esta variable, /api/email/inbound rechaza peticiones en producción
# (503) por seguridad. En desarrollo se procesa con un aviso.
RESEND_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Google Places API — reseñas de Google Business Profile
# -----------------------------------------------------------------------------
# API Key de Google Cloud con Places API (New) activada.
# Se usa en servidor para obtener reseñas del perfil de Google Business.
# Sin esta variable, se muestran reseñas locales de fallback.
GOOGLE_PLACES_API_KEY=
# Place ID del perfil de Google Business (obtenido del iframe de Google Maps).
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# -----------------------------------------------------------------------------
# OAuth2 de Google (GA4 Data API + Search Console API) — credenciales del cliente OAuth
# Usadas por scripts/oauth-get-refresh-token.mjs y /api/oauth/callback.
# Obtener en GCP Console → APIs y servicios → Credenciales → OAuth 2.0 Client ID.
# NUNCA commitear el client_secret en código: debe ir solo en .env.local.
# -----------------------------------------------------------------------------
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# IndexNow (notificación de contenido nuevo a Bing, Yandex, Seznam, etc.)
# -----------------------------------------------------------------------------
# Clave de IndexNow (formato UUID sin guiones, ej. bbbbda6cdb1e4e2cbe8f6f81c1886f58).
# Genera una nueva en https://www.bing.com/indexnow/getstarted
# La clave se sirve vía /api/indexnow-key y se usa en el script postbuild.
INDEXNOW_KEY=

# -----------------------------------------------------------------------------
# Clouding.io — VPS para deploy opcional de Twenty CRM (2GB/1vCore/30GB = 8€/mo)
# API endpoint: https://api.clouding.io/v1
# Guardar la clave generada en el panel de Clouding.io
# -----------------------------------------------------------------------------
CLOUDING_API_KEY=
CLOUDING_SSH_KEY=

# =============================================================================
# SGIE Autopilot — Sistema de Gestión Integral de Expedientes
# =============================================================================
# Variables requeridas para el módulo SGIE (Fases 1-10).
# Sin estas variables, algunas funcionalidades operan en modo degradado:
#  - Sin CRON_SECRET → jobs documentales no se procesan automáticamente.
#  - Sin RESEND_API_KEY → envío de correos falla (registrado sin enviar).
#  - Sin IA_DOCUMENTAL_API_KEY → IA funciona en modo heuristic (sin DeepSeek).
#  - Sin BLOB_READ_WRITE_TOKEN → documentos se guardan en filesystem local.
# =============================================================================

# -----------------------------------------------------------------------------
# SGIE — Cron / Worker para procesamiento asíncrono de jobs
# -----------------------------------------------------------------------------
# Secreto compartido para proteger el endpoint de cron.
# Generar uno seguro: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configurar en Vercel → Settings → Environment Variables.
# Programar cron en Vercel: vercel.json → "crons": [{"path": "/api/cron/sgie/procesar", "schedule": "*/5 * * * *"}]
# Uso: curl -H "Authorization: Bearer $CRON_SECRET" https://DOMINIO/api/cron/sgie/procesar
CRON_SECRET=

# -----------------------------------------------------------------------------
# SGIE — Vercel Blob Storage (documentos de expedientes)
# -----------------------------------------------------------------------------
# Token de lectura/escritura de Vercel Blob.
# Obtenlo en Vercel Dashboard → Storage → tu Blob store → Settings.
# Sin esta variable, los documentos se almacenan en filesystem local (solo dev).
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# SGIE — IA Documental (DeepSeek V4 o compatible con API OpenAI-like)
# -----------------------------------------------------------------------------
# Proveedor de IA para extracción y clasificación de documentos.
# Valores soportados: deepseek, openai, openrouter, etc.
IA_DOCUMENTAL_PROVIDER=deepseek
# Modelo a usar. Ejemplos: deepseek-chat, deepseek-reasoner, gpt-4o-mini.
IA_DOCUMENTAL_MODEL=deepseek-chat
# URL base de la API (sin /chat/completions).
IA_DOCUMENTAL_BASE_URL=https://api.deepseek.com/v1
# API key del proveedor. NUNCA hardcodear ni commitear.
IA_DOCUMENTAL_API_KEY=
# Modo de operación:
#   disabled  — Sin IA, documentos quedan en pendiente_abogado.
#   heuristic — Solo clasificación/extracción local (sin llamadas externas).
#   ai        — Heurística + DeepSeek si la confianza es baja.
IA_DOCUMENTAL_MODE=heuristic
# Timeout en milisegundos por llamada a la IA.
IA_DOCUMENTAL_TIMEOUT_MS=60000
# Máximo de reintentos si la IA falla (errores de red o 429/5xx).
IA_DOCUMENTAL_MAX_RETRIES=2

# =============================================================================
# SGIE — Seeds para staging/desarrollo (NO ejecutar en producción sin revisión)
# =============================================================================
#   npm run seed:sgie:plantillas   → 10 plantillas de correo base.
#   npm run seed:sgie:demo:carlos  → Datos demo para el abogado Carlos Pineda.
#   npm run seed:sgie:procedimientos → 404 procedimientos jurídicos.
#
# Orden recomendado para staging:
#   1. npx drizzle-kit push          (aplicar migraciones)
#   2. npm run seed:sgie:procedimientos
#   3. npm run seed:sgie:plantillas
#   4. npm run seed:sgie:demo:carlos
#
# NOTA: El seed demo de Carlos inserta datos ficticios claramente marcados.
# No contiene datos personales reales. La contraseña usa un hash bcrypt
# placeholder; debe configurarse una contraseña real mediante el panel admin
# o script de configuración inicial. El usuario Carlos es idempotente:
# no se duplica ni sobrescribe si ya existe.
# =============================================================================

# Bing Webmaster Tools OAuth (Device Code Flow)
# 1. Registrar app en Azure AD (ver docs/seo/bing-webmaster-oauth.md)
# 2. Copiar el Application (client) ID
# 3. Ejecutar npm run bing:auth
BING_CLIENT_ID=
# Opcional: 'consumers' para cuentas personales, 'common' por defecto
BING_TENANT=common

# =============================================================================
# Cloudflare Turnstile (captcha formularios públicos)
# =============================================================================
# Crea un sitio en https://dash.cloudflare.com/?to=/:account/turnstile
# Mode recomendado: Managed o Invisible. Claves por dominio.
# Si NO se configuran, los endpoints /api/contacto, /api/consulta y
# /api/subscribe hacen bypass seguro (rate-limit permanece como red de
# seguridad). Configúralo en producción para máxima protección antispam.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Esta clave pública la lee el widget en cliente (NEXT_PUBLIC_*).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# =============================================================================
# Chat asistente público (DeepSeek)
# =============================================================================
# Endpoint server-side: POST /api/chat. La API key NUNCA sale del servidor;
# el widget solo llama a /api/chat (relativa, same-origin).
#
# CHAT_ENABLED: "false" desactiva el widget globalmente sin tocar código.
# DEEPSEEK_MODEL: identificador del modelo. Por defecto "deepseek-v4-flash"
#   (requerimiento del proyecto). Los identificadores oficiales de la API de
#   DeepSeek pueden variar; si el proveedor devuelve error de modelo, basta
#   con cambiar esta variable (p. ej. a "deepseek-chat"), sin modificar código.
#   El endpoint entra en modo fallback seguro si el modelo falla o no hay key.
# El historial de conversación NO se persiste: el cliente envía solo los
# últimos turnos por mensaje. sessionId vive en localStorage del navegador.
CHAT_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=400
CHAT_TIMEOUT_MS=20000
CHAT_MAX_MESSAGE_LENGTH=600
CHAT_RATE_LIMIT_PER_IP=12
CHAT_RATE_LIMIT_PER_SESSION=12
CHAT_RATE_WINDOW_MS=600000
