# ─────────────────────────────────────────────────────────────
# .gitignore — Pineda y Asociados / Justicia Verdadera
# ─────────────────────────────────────────────────────────────

# ── Dependencias ────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build & Next.js ─────────────────────────────────────────
/build
/.next/
/out/
.next/

# ── Environment & Secrets ───────────────────────────────────
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
.secrets/
*.pem
*.key

# ── Editor & OS ─────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*~
Thumbs.db

# ── IDE ─────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ── Testing ─────────────────────────────────────────────────
/coverage/
/test-results/
/playwright-report/
/playwright/.cache/

# ── Debug & Logs ────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── Generated Data & Outputs ────────────────────────────────
/output/
/exports/
/.backups/
/data/google/
/data/bing/
/data/seo/
*.tmp
deps-audit.json
deps-outdated.json

# ── Migrations (solo artefactos generados) ──────────────────
# Las migraciones SQL son source of truth; no ignorar drizzle/migrations/*.sql
/drizzle/migrations/meta/

# ── PWA ─────────────────────────────────────────────────────
# Service Worker: arquitectura route handler (app/sw.js/route.ts)
# No hay artefactos generados en disco.

# ── Local Tooling ───────────────────────────────────────────
.zcode/
.tools-cache/

# ── ZIPs & Backups locales ──────────────────────────────────
*.zip
*.tar.gz
*.7z

# ── Misc ────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
nul
.vercel/
.env.vercel
.fase3b-fuentes/
.fase3d-fuentes/
