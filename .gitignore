# ─────────────────────────────────────────────────────────────
# .gitignore — Pineda y Asociados / Justicia Verdadera
# ─────────────────────────────────────────────────────────────

# ── Dependencias ────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build & Next.js ─────────────────────────────────────────
/build
/.next/
/out/
.next/

# ── Environment & Secrets ───────────────────────────────────
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.e2e.local
.env.vercel
.env*
!.env.example
!.env.*.example
.secrets/
*.pem
*.key

# ── Editor & OS ─────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*~
Thumbs.db

# ── IDE ─────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ── Solo local (no subir a GitHub) ───────────────────────────
/docs/
/scripts/
/data/

# ── Testing ─────────────────────────────────────────────────
/coverage/
/test-results/
/playwright-report/
/playwright/.cache/

# ── E2E Staging (PR #20) ────────────────────────────────────
# Entorno E2E aislado: artifacts locales + reports JSON.
.env.e2e.local
.local/
.local/e2e-results.json

# ── Debug & Logs ────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log


# ── Generated Data & Outputs ────────────────────────────────
/output/
/exports/
/reports/
/generated/
/.backups/
*.tmp
*.dump
*.sql.gz
deps-audit.json
deps-outdated.json

# ── Migrations (solo artefactos generados) ──────────────────
# Las migraciones SQL son source of truth; no ignorar drizzle/migrations/*.sql
# El journal y snapshots de Drizzle están versionados y NO se ignoran.
# /drizzle/migrations/meta/  # NO ignorar — los metadatos son trazabilidad

# ── PWA ─────────────────────────────────────────────────────
# Service Worker: arquitectura route handler (app/sw.js/route.ts)
# No hay artefactos generados en disco.

# ── Local Tooling & memorias de agentes ─────────────────────
.zcode/
.tools-cache/
memories/
.omo/
.playwright-mcp/

# ── ZIPs & Backups locales ──────────────────────────────────
*.zip
*.tar.gz
*.7z

# ── Misc ────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
nul
.vercel/
.fase3b-fuentes/
.fase3d-fuentes/
.neon
