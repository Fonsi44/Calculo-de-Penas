# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
!.env.example

# vercel
.vercel

# debug logs
open-debug/

# next.js logs
next-stderr.log
next-stdout.log

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# CP index (regenerable desde scripts/build-cp-index.cjs)
/data/cp-indice.json

# tool-output local (caches de webfetch)
/.tool-output/
