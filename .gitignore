# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
!.env.example

# vercel
.vercel

# IndexNow cache local (URLs enviadas + timestamps; sin secretos pero
# es estado local de cada entorno, no debe versionarse)
.indexnow-cache.json

# debug logs
open-debug/

# next.js logs
next-stderr.log
next-stdout.log

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# CP index (regenerable desde scripts/build-cp-index.cjs)
/data/cp-indice.json

# tool-output local (caches de webfetch)
/.tool-output/

# opencode + agent debug
.opencode/
home-*.png
neon-mcp-*.log
.playwright-mcp/
opencode.jsonc
scripts/validate-opencode-config.cjs
.env*

# security: no commitear claves públicas ni archivos de infraestructura
*.pub

# legacy wordpress
/wordpress/

# imagenes RAW
docs/imagenes/*.png
docs/imagenes/*.jpg

# screenshots y capturas de pantalla
*-fullpage.png
*-mobile.png
*-desktop.png
*-after.png
/docs/screenshots/
# visual regression: outputs temporales (baselines SÍ se commitean en e2e/visual-baselines/)
/docs/screenshots-current/
/docs/screenshots-diff/

# artifactos de test/benchmark
servicios-juridicos-accessibility.yml
post-submit.yml
solicitar-consulta-form.yml

# logs locales
build-output.log
dev-log.txt
dev-server-err.log
dev-server.log
cookies.txt
.vercel-env-check.txt

# auditorias exportadas
auditoria-blog/
docs/backups/
