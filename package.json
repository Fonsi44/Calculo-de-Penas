{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/submit-indexnow.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "indexnow:dry": "node scripts/submit-indexnow.mjs --dry-run",
    "indexnow:audit": "node scripts/submit-indexnow.mjs --dry-run --full",
    "indexnow:sample": "ENABLE_INDEXNOW_SUBMIT=true node scripts/submit-indexnow.mjs --sample",
    "indexnow:core": "ENABLE_INDEXNOW_SUBMIT=true node scripts/submit-indexnow.mjs",
    "indexnow:full": "ENABLE_INDEXNOW_SUBMIT=true node scripts/submit-indexnow.mjs --full",
