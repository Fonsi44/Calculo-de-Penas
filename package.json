    "validate:dates": "npx tsx scripts/validar-fechas-blog.ts",
    "seed:fase2": "npx tsx drizzle/seed-fase2.ts",
    "db:check": "npx tsx scripts/check-db-state.ts",
    "seo:health": "node scripts/seo-health-check.mjs",
    "seo:health:json": "node scripts/seo-health-check.mjs --json",
    "visual:baseline": "node scripts/visual-regression.cjs baseline",
    "visual:check": "node scripts/visual-regression.cjs check",
    "visual:update": "node scripts/visual-regression.cjs update"
